# Copy to .env before running Docker Compose. .env is ignored by Git.
MAIL_DOMAIN=mail.example.com
DATA_DIR=/data
SMTP_ADDR=:2525
HTTP_ADDR=:8080

# Leave both empty for plaintext SMTP. Set both when the certificate manager
# stages fullchain.pem and privkey.pem in the read-only smtp-certs volume.
SMTP_TLS_CERT_FILE=
SMTP_TLS_KEY_FILE=

# Keep metrics private to the Compose network; do not add a public 9090 port.
METRICS_ADDR=:9090
METRICS_ENABLED=false

MESSAGE_TTL=1h
MAX_MESSAGE_BYTES=2097152
MAX_STORAGE_BYTES=21474836480

# SMTP admission and amplification controls.
SMTP_MAX_CONNECTIONS=100
SMTP_MAX_CONNECTIONS_PER_IP=10
SMTP_MAX_RECIPIENTS=5

# HTTP overload, rate-limit, and access-log controls.
HTTP_MAX_CONCURRENT_REQUESTS=512
HTTP_ACCESS_LOG_MODE=errors
HTTP_LOG_HEADERS=User-Agent
HTTP_RATE_LIMIT_RPS=10
HTTP_RATE_LIMIT_BURST=50
# By default the client IP for rate-limiting is RemoteAddr; set this only behind a trusted
# reverse proxy that sets/overwrites the header itself (e.g. Cloudflare's CF-Connecting-IP),
# otherwise clients can spoof it directly.
# HTTP_RATE_LIMIT_IP_HEADER=CF-Connecting-IP

# Optional metadata analytics and private admin listener; both disabled by default.
ADMIN_ENABLED=false
ADMIN_ADDR=127.0.0.1:8081
ANALYTICS_ENABLED=false
ANALYTICS_EVENT_TTL=720h
ANALYTICS_MAX_STORAGE_BYTES=1073741824
# Docker admin access: set ADMIN_ADDR=:8081 and enable the loopback-only mapping
# described in compose.yaml. A separate listener does not provide authentication.
