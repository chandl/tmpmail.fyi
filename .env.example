# Copy to .env before running Docker Compose. .env is ignored by Git.
MAIL_DOMAIN=mail.example.com
DATA_DIR=/data
SMTP_ADDR=:2525
HTTP_ADDR=:8080

# Leave both empty for plaintext SMTP. Set both when the certificate manager
# stages fullchain.pem and privkey.pem in the read-only smtp-certs volume.
SMTP_TLS_CERT_FILE=
SMTP_TLS_KEY_FILE=

# Keep metrics private to the Compose network; do not add a public 9090 port.
METRICS_ADDR=:9090
METRICS_ENABLED=false

MESSAGE_TTL=1h
MAX_MESSAGE_BYTES=2097152
MAX_STORAGE_BYTES=21474836480

# SMTP admission and amplification controls.
SMTP_MAX_CONNECTIONS=100
SMTP_MAX_CONNECTIONS_PER_IP=10
SMTP_MAX_RECIPIENTS=5

# HTTP overload and access-log controls.
HTTP_MAX_CONCURRENT_REQUESTS=512
HTTP_ACCESS_LOG_MODE=errors
HTTP_LOG_HEADERS=User-Agent
